    "\n",
    "# ၂။ Graph ပုံသဏ္ဍာန် ဖန်တီးခြင်း\n",
    "fig, ax = plt.subplots(figsize=(11, 6), dpi=100)\n",
    "\n",
    "# Colors Palette (လှပသပ်ရပ်သော အရောင်လိုင်းများ)\n",
    "rects1 = ax.bar(x - width*2, bleu_scores, width, label='BLEU Score', color='#1f77b4', edgecolor='black', linewidth=0.5)\n",
    "rects2 = ax.bar(x - width, p1, width, label='1-gram Precision', color='#aec7e8', edgecolor='black', linewidth=0.5)\n",
    "rects3 = ax.bar(x, p2, width, label='2-gram Precision', color='#ff7f0e', edgecolor='black', linewidth=0.5)\n",
    "rects4 = ax.bar(x + width, p3, width, label='3-gram Precision', color='#ffbb78', edgecolor='black', linewidth=0.5)\n",
    "rects5 = ax.bar(x + width*2, p4, width, label='4-gram Precision', color='#2ca02c', edgecolor='black', linewidth=0.5)\n",
    "\n",
