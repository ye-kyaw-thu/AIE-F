    "ax.legend(loc='upper right', bbox_to_anchor=(1, 1), shadow=True, fontsize=10)\n",
    "ax.grid(axis='y', linestyle='--', alpha=0.5)\n",
    "\n",
    "# ၄။ Bar တုံးတစ်ခုချင်းစီရဲ့ အပေါ်မှာ ဂဏန်းတန်ဖိုး (Score) များ ရေးပေးမည့် Function\n",
